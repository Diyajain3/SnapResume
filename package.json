{
  "name": "snapresume",
  "version": "1.0.0",
  "description": "Unified Full-Stack Resume Builder",
  "main": "server/server.js",
  "type": "module",
  "scripts": {
    "install:client": "npm install --production=false --prefix client",
    "install:server": "npm install --prefix server",
    "build:client": "npm run build --prefix client",
    "postinstall": "npm run install:client && npm run install:server",
    "build": "npm run postinstall && npm run build:client",
    "start": "node server/server.js",
    "dev": "npm run dev --prefix server"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.6.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.4.1",
    "multer": "^2.1.1",
    "openai": "^6.39.0",
    "path": "^0.12.7"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
